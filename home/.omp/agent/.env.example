# Copy to .env (gitignored) next to this file; omp loads it at startup.
# omp-owned secrets, referenced by name from models.yml (apiKey).

# DGX vLLM server auth (providers.vllm.apiKey)
VLLM_API_KEY=<DGX_VLLM_API_KEY> # FIXME: set your DGX vLLM API key

# Liquid D1-3B judge auth (providers.system-one.apiKey)
D1_API_KEY=<D1_JUDGE_API_KEY> # FIXME: set your D1 judge API key

# Hindsight memory backend auth (overrides hindsight.apiToken; env wins over config.yml)
HINDSIGHT_API_TOKEN=<HINDSIGHT_API_TOKEN> # FIXME: set your Hindsight API token
