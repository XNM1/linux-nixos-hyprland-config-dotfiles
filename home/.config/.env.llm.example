# AI endpoint settings. Copy to ~/.config/.env.llm, chmod 600.
# Use literal, unquoted values with no inline comments or $VARIABLE references.
# Symlink aichat/.env to ../.env.llm for use outside fish (see README).
# FIXME: Replace <DGX_TAILSCALE_IP> with your vLLM server's address.
VLLM_API_BASE=http://<DGX_TAILSCALE_IP>:8000/v1
# FIXME: Set your vLLM API key.
VLLM_API_KEY=replace-with-your-dgx-vllm-api-key

# These configure that AI request, not a secondary endpoint or backup model.
# FIXME: Set the model name served by your vLLM endpoint.
