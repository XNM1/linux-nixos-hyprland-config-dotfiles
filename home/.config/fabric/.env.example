# Copy to .env (gitignored) next to this file; fabric loads it from ~/.config/fabric/.env
# Defaults written by `fabric -d` (wizard); OpenAI vendor pointed at the remote DGX vLLM
# server, so `fabric -p <pattern>` / piped input uses the remote model out of the box.
DEFAULT_VENDOR=OpenAI
DEFAULT_MODEL=qwen3.8-flash-next
DEFAULT_MODEL_CONTEXT_LENGTH=262144
# Custom base URL for the OpenAI vendor (fabric's canonical name for it)
OPENAI_API_KEY=<DGX_VLLM_API_KEY> # FIXME: set your DGX vLLM API key
OPENAI_API_BASE_URL=http://<DGX_TAILSCALE_IP>:8000/v1 # FIXME: set your DGX Tailscale IP (the host running vLLM)
# Registers the native Ollama vendor for local models (without it `fabric -L` only lists
# the default vendor); local models then need the vendor: fabric -V Ollama -m gemma4:e2b
OLLAMA_API_URL=http://localhost:11434
